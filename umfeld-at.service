[Unit]
Description=umfeld-at — NE cells and public overlays for Austria
After=network-online.target umfeld-at.socket
Wants=network-online.target
# The socket unit owns :8000 across restarts: connections queue in the kernel
# while the process is replaced, none is refused (startup.go, docs/restart.md).
Requires=umfeld-at.socket

[Service]
# READY=1 is sent when the accept loop runs: `systemctl restart` returns when
# the service answers, and fails when it does not (scripts/deploy.sh rolls back).
Type=notify
NotifyAccess=main
TimeoutStartSec=120
# SIGTERM drains in-flight requests for up to 10 s (startupDrain).
TimeoutStopSec=20
# Self-ping through the accept loop every 30 s; three misses = restart.
WatchdogSec=90
# scripts/install.sh fills User/Group, WorkingDirectory, ExecStart and
# ReadWritePaths from the checkout it runs in.
User=umfeld
Group=umfeld
WorkingDirectory=/opt/umfeld-at
ExecStart=/opt/umfeld-at/umfeld-at
Restart=always
RestartSec=1

Environment=PORT=8000
Environment=CGO_ENABLED=1
# Tokens, peer URLs, private prefix — peers.go, docs/api-tiers.md. 0600, never in git.
EnvironmentFile=-/etc/umfeld-at.env
# Soft GC ceiling; the SQLite page caches live outside the Go heap.
Environment=GOMEMLIMIT=3GiB
# Hard ceiling: a runaway process is OOM-killed and back in seconds.
MemoryMax=5G
MemorySwapMax=256M
OOMPolicy=kill

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/umfeld-at/data
PrivateTmp=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=umfeld-at

[Install]
WantedBy=multi-user.target
